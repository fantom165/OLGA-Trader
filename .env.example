# Copy to .env and fill in whichever key you have. .env is git-ignored.
#
# With data.provider = "auto" in config/watchlist.json, the app picks the first
# keyed provider in this order: Tiingo, Polygon, Yahoo. Yahoo needs no key, so
# an empty file still runs.

# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# --- Optional overrides -------------------------------------------------- #

# Force one provider for this run: auto | tiingo | polygon | yahoo
# OLGA_PROVIDER=

# Parallel requests per provider. Polygon free tier is 5 requests/minute.
# TIINGO_MAX_WORKERS=4
# POLYGON_MAX_WORKERS=1

# API hosts, if a vendor ever moves.
# TIINGO_BASE_URL=https://api.tiingo.com
# POLYGON_BASE_URL=https://api.polygon.io

# --- Ask OLGA (Vertex AI Gemini) ----------------------------------------- #
# Pin to the olga-trader GCP project. ADC from `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=olga-trader
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=LOW
# OLGA_LLM=off
# GEMINI_API_KEY=
